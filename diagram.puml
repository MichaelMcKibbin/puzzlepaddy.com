@startuml
hide methods
hide stereotypes
skinparam linetype ortho

entity "ApplicationUser" as User {
  * Id : string
  --
  UserName : string
  Email : string
  FullName : string
  CreatedAtUtc : datetime
}

entity "Role" as Role {
  * Id : string
  --
  Name : string
}

entity "UserRole" as UserRole {
  * UserId : string
  * RoleId : string
}

entity "Case" as Case {
  * Id : UUID
  --
  Title : string
  Description : text
  Status : WorkflowStatus
  Priority : string
  CreatedAtUtc : datetime
  UpdatedAtUtc : datetime
  CreatedByUserId : string
  AssignedToUserId : string
}

entity "CaseNote" as CaseNote {
  * Id : UUID
  --
  CaseId : UUID
  AuthorUserId : string
  NoteText : text
  CreatedAtUtc : datetime
}

entity "CaseStatusHistory" as CaseHistory {
  * Id : UUID
  --
  CaseId : UUID
  ChangedByUserId : string
  FromStatus : WorkflowStatus
  ToStatus : WorkflowStatus
  ChangedAtUtc : datetime
  Comment : string
}

User ||--o{ UserRole
Role ||--o{ UserRole

User ||--o{ Case : .  creates >
User ||--o{ Case : .  assigned to >
Case ||--o{ CaseNote
User ||--o{ CaseNote : .  writes >
Case ||--o{ CaseHistory
User ||--o{ CaseHistory : . changes >

@enduml